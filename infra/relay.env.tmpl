# Non-secret relay env. Rendered to /etc/peerkit-relay.env by infra/deploy.sh on
# every deploy; __RESERVED_IP__ is substituted with the DO Reserved IP.
# Secrets live in /etc/peerkit-relay.secrets.env, not here.
PEERKIT_RELAY_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip6/::/tcp/4001
PEERKIT_PUBLIC_HOST=__RESERVED_IP__
PEERKIT_LOG_LEVEL=info
PEERKIT_RELAY_CERTIFICATE_FILE=certs/relay-cert.json
